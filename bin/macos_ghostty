#!/usr/bin/osascript

on run argv
  tell application "Ghostty"
    # Ensure there's a Ghostty.app window.
    set _window to front window
    if _window is equal to missing value then
      new window
    end if

    # Bring Ghostty.app to the front.
    activate

    # Run the command sent from vim-test.
    set term to focused terminal of selected tab of front window
    input text (item 1 of argv) to term
    send key "enter" to term
  end tell

  tell application "MacVim"
    # Return MacVim.app to the front.
    activate
  end tell
end run
