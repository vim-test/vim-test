{
 "$schema": "https://docs.renovatebot.com/renovate-schema.json",
 "extends": [
   "config:recommended"
 ],
 "enabledManagers": [
   "github-actions",
   "ruby-version"
 ],
 "ignorePaths": [
   "spec/**"
 ],
 "packageRules": [
   {
     "description": "Block Ruby major updates until vim-flavor's gemspec (required_ruby_version ~> 3.0) lifts the cap",
     "matchDepNames": [
       "ruby"
     ],
     "matchUpdateTypes": [
       "major"
     ],
     "enabled": false
   }
 ]
}
